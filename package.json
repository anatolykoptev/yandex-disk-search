{
  "name": "yandex-disk-search",
  "version": "2.2.6",
  "description": "Chrome extension for searching files on public Yandex Disk pages",
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts --bundle --outfile=dist/content.js --target=chrome88 --format=iife && cp src/styles/content.css dist/",
    "watch": "esbuild src/content.ts --bundle --outfile=dist/content.js --target=chrome88 --format=iife --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/yandex-disk-search.git"
  },
  "keywords": [
    "chrome-extension",
    "yandex-disk",
    "search"
  ],
  "author": "anatolykoptev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anatolykoptev/yandex-disk-search/issues"
  },
  "homepage": "https://github.com/anatolykoptev/yandex-disk-search#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  }
}
